{
  "version": "2.0.0",
  // どのタスクもDev Container（Codespaces）の中で実行する前提。
  // ローカルのmacOSにはuplatexが無いため、PDFビルドはコンテナ外では失敗する。
  "tasks": [
    {
      "label": "記法チェック（開いている.reファイル）",
      "type": "shell",
      "command": "bundle exec review-compile --target=latex ${fileBasename} > /dev/null",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "detail": "contents/ の .re を開いた状態で実行する。記法エラーだけを素早く確認する。"
    },
    {
      "label": "EPUBをビルド",
      "type": "shell",
      "command": "bundle exec review-epubmaker config.yml",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "detail": "sauna-entry-book.epub を生成する。執筆中の確認用。"
    },
    {
      "label": "PDFをビルド",
      "type": "shell",
      "command": "bundle exec review-pdfmaker config.yml",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "detail": "sauna-entry-book.pdf を生成する。組版崩れの確認はこちら。"
    },
    {
      "label": "HTMLプレビュー（ポート8000）",
      "type": "shell",
      "command": "bundle exec review-webmaker config.yml && ruby -run -e httpd webroot -p 8000",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "detail": "全章をHTML化してローカルサーバで配信する。停止はCtrl+C。"
    },
    {
      "label": "生成物をクリーン",
      "type": "shell",
      "command": "bundle exec rake clean",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "detail": "PDF/EPUB/中間ディレクトリを削除する。ビルドがおかしくなったときに。"
    }
  ]
}
