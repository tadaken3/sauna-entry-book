% for user-defined macro

% 柱（ヘッダー）の出し分け
% 既定では左右ヘッダーに章タイトル(\leftmark)と節タイトル(\rightmark)が
% 同時に出力されるため、A5判では衝突する。見開きで出し分けるよう上書きする。
%   - 偶数ページ(左ページ): 章タイトル
%   - 奇数ページ(右ページ): 節タイトル
\fancyhead{}
\fancyhead[LE]{\gtfamily\sffamily\bfseries\upshape \leftmark}
\fancyhead[RO]{\gtfamily\sffamily\bfseries\upshape \rightmark}

% 目次のドットリーダーを消す
% ドットは「必要な項を引きに戻ってくる本」の記号で、通読される本には要らない。
% 節(==)の行だけが \@dottedtocline 経由でドットを引くので、そこで使われる
% \jsTocLine を差し替える。章(=)の行はもともとドットを引かない。
\def\jsTocLine{\hfill}
